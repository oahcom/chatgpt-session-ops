+"""Shared credential-directory contract for Sender Gateway and CLI."""
+from __future__ import annotations
+import os
+from pathlib import Path
+
+_CREDENTIAL_FILES = ("cookies.json", "access_token.txt")
+
+def has_credentials(path: Path) -> bool:
+    # Preserve Gateway's no-symlink trust boundary for both account dirs and
+    # credential markers; Path.is_dir()/is_file() alone follow symlinks.
+    if path.is_symlink() or not path.is_dir():
+        return False
+    return all(
+        not (path / name).is_symlink() and (path / name).is_file()
+        for name in _CREDENTIAL_FILES
+    )
+
+class AccountDirectoryResolver:
+    def __init__(self, auth_root, accounts_dir=None):
+        self.auth_root = Path(auth_root).expanduser()
+        self.accounts_dir = Path(accounts_dir).expanduser() if accounts_dir is not None else self.auth_root / "accounts"
+
+    @classmethod
+    def from_environment(cls, base_dir=None, accounts_dir=None, prefer_base=False):
+        configured = accounts_dir if accounts_dir is not None else os.environ.get("SO_SENDER_ACCOUNTS_DIR")
+        env_root = os.environ.get("CHATGPT_AUTH_DIR")
+        if prefer_base and base_dir:
+            auth_root = base_dir
+        elif env_root:
+            auth_root = env_root
+        elif configured:
+            configured_path = Path(configured).expanduser()
+            auth_root = configured_path.parent if configured_path.name == "accounts" else configured_path
+        else:
+            auth_root = base_dir
+        if not auth_root:
+            raise ValueError("an auth root is required")
+        return cls(auth_root, configured or (Path(auth_root) / "accounts"))
+
+    def account_dir(self, account):
+        if account in ("default", "acct1"):
+            root_has = has_credentials(self.auth_root)
+            legacy = self.accounts_dir / "acct1"
+            legacy_has = has_credentials(legacy)
+            if root_has and legacy_has and legacy.resolve() != self.auth_root.resolve():
+                raise ValueError("ambiguous acct1 credential directories")
+            if root_has:
+                return self.auth_root
+            if legacy_has:
+                return legacy
+            return self.auth_root
+        if account == "nologin":
+            return self.accounts_dir / "nologin"
+        if not isinstance(account, str) or not account.startswith("acct"):
+            raise ValueError("invalid account identity")
+        suffix = account[4:]
+        if not suffix.isdigit() or int(suffix) < 2:
+            raise ValueError("invalid account identity")
+        return self.accounts_dir / account
+
+    def discover_accounts(self):
+        found = set()
+        if has_credentials(self.account_dir("acct1")):
+            found.add("acct1")
+        if self.accounts_dir.is_dir():
+            for entry in self.accounts_dir.iterdir():
+                if entry.name.startswith("acct") and entry.name[4:].isdigit() and int(entry.name[4:]) >= 2 and has_credentials(self.account_dir(entry.name)):
+                    found.add(entry.name)
+        return tuple(sorted(found, key=lambda name: int(name[4:])))
+
+def discover_accounts(accounts_dir, auth_root=None):
+    if auth_root is None:
+        auth_root = os.environ.get("CHATGPT_AUTH_DIR") or (
+            Path(accounts_dir).parent if Path(accounts_dir).name == "accounts" else accounts_dir
+        )
+    return AccountDirectoryResolver(auth_root, accounts_dir).discover_accounts()
