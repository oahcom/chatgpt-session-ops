     # -- reads ---------------------------------------------------------
 
+    def claim_events(
+        self,
+        worker_id: str,
+        *,
+        limit: int = 25,
+        lease_seconds: float = 30.0,
+        now: str | None = None,
+    ) -> list[dict]:
+        """Claim due completion events for the authenticated MCP dispatcher."""
+        if not isinstance(worker_id, str) or not worker_id.strip():
+            raise StoreError("worker_id is required", code=ErrorCode.INVALID_ARGUMENT)
+        if isinstance(limit, bool) or not isinstance(limit, int) or not 1 <= limit <= 100:
+            raise StoreError("limit must be in 1..100", code=ErrorCode.INVALID_ARGUMENT)
+        if not 1 <= float(lease_seconds) <= 300:
+            raise StoreError("lease_seconds must be in 1..300", code=ErrorCode.INVALID_ARGUMENT)
+        claimed_at = now or self._now()
+        lease_until = add_seconds(claimed_at, float(lease_seconds))
+        claimed: list[dict] = []
+        with self.transaction() as txn:
+            txn.execute(
+                """UPDATE job_event_outbox
+                   SET status='pending', lease_until=NULL, lease_token=NULL, worker_id=NULL
+                   WHERE status='sending' AND lease_until<=?""",
+                (claimed_at,),
+            )
+            rows = txn.fetchall(
+                """SELECT * FROM job_event_outbox
+                   WHERE status='pending' AND next_attempt_at<=?
+                   ORDER BY created_at, event_id LIMIT ?""",
+                (claimed_at, limit),
+            )
+            for row in rows:
+                lease_token = uuid.uuid4().hex
+                cursor = txn.execute(
+                    """UPDATE job_event_outbox
+                       SET status='sending', attempts=attempts+1, worker_id=?,
+                           lease_until=?, lease_token=?
+                       WHERE event_id=? AND status='pending'""",
+                    (worker_id, lease_until, lease_token, row["event_id"]),
+                )
+                if cursor.rowcount == 1:
+                    claimed.append({
+                        "event_id": row["event_id"],
+                        "job_id": row["job_id"],
+                        "tenant_id": row["tenant_id"],
+                        "principal_id": row["principal_id"],
+                        "name": row["event_name"],
+                        "payload": json.loads(row["payload_json"]),
+                        "lease_token": lease_token,
+                        "attempt": int(row["attempts"]) + 1,
+                    })
+        return claimed
+
+    def ack_event(self, event_id: str, lease_token: str, *, now: str | None = None) -> bool:
+        """Acknowledge durable MCP ingestion; stale leases cannot ack a new claim."""
+        if not isinstance(event_id, str) or not event_id or not isinstance(lease_token, str) or not lease_token:
+            raise StoreError("event_id and lease_token are required", code=ErrorCode.INVALID_ARGUMENT)
+        acknowledged_at = now or self._now()
+        with self.transaction() as txn:
+            row = txn.fetchone(
+                "SELECT status, lease_token FROM job_event_outbox WHERE event_id=?",
+                (event_id,),
+            )
+            if row is None:
+                return False
+            if row["status"] == "delivered":
+                return True
+            if row["status"] != "sending" or row["lease_token"] != lease_token:
+                return False
+            txn.execute(
+                """UPDATE job_event_outbox
+                   SET status='delivered', delivered_at=?, lease_until=NULL,
+                       lease_token=NULL, worker_id=NULL
+                   WHERE event_id=? AND status='sending' AND lease_token=?""",
+                (acknowledged_at, event_id, lease_token),
+            )
+        return True
