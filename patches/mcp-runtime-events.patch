     async def __call__(self, scope: Any, receive: Any, send: Any) -> None:
+        if scope.get("type") == "lifespan" and self.background_workers:
+            started_workers: list[Any] = []
+            stopped_workers: set[int] = set()
+
+            async def receive_with_worker_lifecycle() -> dict[str, Any]:
+                message = await receive()
+                if message.get("type") == "lifespan.startup":
+                    for worker in self.background_workers:
+                        worker.start()
+                        started_workers.append(worker)
+                elif message.get("type") == "lifespan.shutdown":
+                    for worker in reversed(started_workers):
+                        worker.stop()
+                        stopped_workers.add(id(worker))
+                return message
+
+            try:
+                await self.inner(scope, receive_with_worker_lifecycle, send)
+            finally:
+                for worker in reversed(started_workers):
+                    if id(worker) not in stopped_workers:
+                        worker.stop()
+            return
+
         if scope.get("type") != "http":
