# ==========================================================
# 凭据 / 身份（绝不入库：泄露等于账号被接管）
# ==========================================================
cookies.json
access_token.txt
**/cookies.json
**/access_token.txt
scripts/accounts/*/cookies.json
scripts/accounts/*/access_token.txt
scripts/accounts/nologin/device-cookie.txt
scripts/accounts/nologin/devices/
*.token
*.pem
*.key
.env
.env.*

# ==========================================================
# 运行态与会话产物（本机生成，含私有对话内容）
# ==========================================================
account-rotation.json
conv-accounts.json
conv-accounts.json.highwater.json
anon-sessions.json
anon-sessions/
newchat-map.json
sessions-registry.json
quick-send-log.jsonl
send-queue-log.md
# 本机临时队列 / 探测输出（曾出现在 skill 运行目录，防止误入库）
_convq*.txt
_q*.txt
*_send*.log
replies/
prompts/
quarantine/
# 会话日志（提示词 + 回复全文，按会话拆分）：含私有对话内容，与 replies/ 同等级
logs/
pending-claims.jsonl
conv-api/
*.lock
# B8 槽位 / B15 租约是运行态（测试也会在 BASE 下生成），绝不入库
slots/
lease-*.json
# 出口代理配置可能带账号密码（socks5h://user:pass@host），绝不入库
proxy.json

# 备份副本同样含凭据 / 私有会话 id：`*.bak-<ts>` 不匹配上面的精确文件名规则
*.bak-*
*.corrupt-*

# ==========================================================
# 语言 / 系统
# ==========================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-mcp/
venv/
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# ==========================================================
# proton-batch 运行态（账号库可解出凭据，配置含打码/接码密钥）
# ==========================================================
tools/proton-batch/data/
tools/proton-batch/config.json
tools/proton-batch/.venv/
tools/proton-batch/accounts*.csv
tools/proton-batch/accounts*.json
