[Unit]
Description=Session Ops MCP Server
Documentation=https://github.com/oahcom/chatgpt-session-ops
After=network.target
Wants=network-online.target
After=network-online.target

[Service]
Type=simple

User=ubuntu
Group=ubuntu

WorkingDirectory=/home/ubuntu/ai-projects/chatgpt-session-ops

EnvironmentFile=/etc/so-mcp/so-mcp.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=/home/ubuntu/ai-projects/chatgpt-session-ops/.venv/bin/python -m scripts.run_mcp_server

Restart=on-failure
RestartSec=5s

TimeoutStartSec=30
# Allow ChatGPT preflight/read plus its 420s send timeout, Uvicorn drain, and MCP event drain.
TimeoutStopSec=600
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=so-mcp

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

ReadWritePaths=/var/lib/so-mcp

[Install]
WantedBy=multi-user.target
