[Unit]
Description=Session Ops MCP Server
Documentation=https://github.com/oahcom/chatgpt-session-ops
After=network.target
Wants=network-online.target
After=network-online.target

[Service]
Type=simple

User=ubuntu
Group=ubuntu

WorkingDirectory=/opt/so-mcp

EnvironmentFile=/etc/so-mcp/so-mcp.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SO_SENDER_ACCOUNTS_DIR=/var/lib/chatgpt-session-ops/accounts
Environment=CHATGPT_STATE_DIR=/var/lib/so-mcp/chatgpt-cli
Environment=CHATGPT_PROXY_FILE=/opt/so-sender/cli/proxy.json

ExecStart=/opt/so-mcp/.venv/bin/python -m scripts.run_mcp_server

Restart=on-failure
RestartSec=5s

TimeoutStartSec=30
TimeoutStopSec=15
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=so-mcp

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

ReadWritePaths=/var/lib/so-mcp /var/lib/chatgpt-session-ops/accounts

[Install]
WantedBy=multi-user.target
