[Unit]
Description=Session Ops MCP Server
Documentation=https://github.com/oahcom/chatgpt-session-ops
After=network.target
Wants=network-online.target
After=network-online.target

[Service]
Type=simple

User=ubuntu
Group=chatgpt-sender

WorkingDirectory=/opt/so-mcp

EnvironmentFile=/etc/so-mcp/so-mcp.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CHATGPT_SESSION_OPS_ACCOUNTS_DIR=/var/lib/chatgpt-session-ops/accounts
Environment=CHATGPT_SESSION_OPS_RUNTIME_DIR=/var/lib/so-mcp/chatgpt-session-ops

ExecStart=/opt/so-mcp/.venv/bin/python -m scripts.run_mcp_server

Restart=on-failure
RestartSec=5s

TimeoutStartSec=30
TimeoutStopSec=1900
UMask=0077
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=so-mcp

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# The repository runtime is writable; the existing account vault is read-only.
# Group=chatgpt-sender grants traversal/read access without granting the MCP
# process permission to replace or mutate stored credentials.
ReadWritePaths=/var/lib/so-mcp
ReadOnlyPaths=/var/lib/chatgpt-session-ops/accounts

[Install]
WantedBy=multi-user.target
