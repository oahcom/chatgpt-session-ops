# Template for /etc/so-mcp/so-mcp.env, the EnvironmentFile referenced by
# deploy/so-mcp.service. The service does not start without the four required
# variables below; see docs/DEPLOY-so-mcp.md section 2b for what each one is
# validated as.
#
#   sudo install -d -m 0750 /etc/so-mcp
#   sudo install -m 0600 -o root -g root so-mcp.env.example /etc/so-mcp/so-mcp.env
#
# Then replace every placeholder. They are deliberately fake; do not copy a
# real secret into this file in the repository.
#
# Note: the environment file is hashed into the deployment manifest as an
# external object. Editing it after generating the manifest makes the
# verifier report drift, which is the intended behaviour.

# --- required -------------------------------------------------------------

# OIDC issuer. Absolute HTTPS URL with a non-root path.
SO_MCP_ISSUER=https://auth.example.com/realms/example

# Expected token audience. Same URL rules as the issuer.
SO_MCP_AUDIENCE=https://mcp.example.com/so-mcp

# Persistent SQLite path. The parent directory is created at startup.
# ":memory:" is rejected.
SO_MCP_DB=/var/lib/so-mcp/work-items.sqlite3

# JWT claim that carries the tenant id.
SO_MCP_TENANT_CLAIM=tenant_id

# --- optional -------------------------------------------------------------
# Uncomment only to override the default.

# Derived from SO_MCP_ISSUER's /realms/<name> path when unset.
#SO_MCP_REALM_NAMESPACE=example

#SO_MCP_HOST=127.0.0.1
#SO_MCP_PORT=8791

# critical | error | warning | info | debug | trace
#UVICORN_LOG_LEVEL=info

# Absolute HTTP(S) URL ending in /.well-known/openid-configuration.
# Plain HTTP is only accepted for a loopback host.
#SO_MCP_DISCOVERY_URL=https://auth.internal.example.com/realms/example/.well-known/openid-configuration

# JSON array of argv strings. Element 0 must resolve to an executable file.
# Leaving this unset disables session.context; the rest of the service works.
# Keep it on one line and single-quote it so systemd passes the brackets
# through unchanged. Whether systemd's own quote handling preserves a bare
# (unquoted) JSON array was not verified against a live systemd in the change
# that added this file; the single-quoted form is the one to use.
#SO_MCP_MEMORY_STDIO='["/opt/so-mcp/bin/memory-stdio","--db","/var/lib/so-mcp/ma.sqlite3"]'

# Process log level for the Python logger (not uvicorn's).
#LOG_LEVEL=INFO
